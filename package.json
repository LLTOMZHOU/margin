{
  "name": "margin-hub",
  "version": "0.1.1",
  "description": "Docs where many people and many AI agents write together, hosted on your own machine, VPS or Cloudflare account. Threads in the margin, agent edits as proposals, agents that run on your own computer.",
  "keywords": [
    "agents",
    "collaboration",
    "crdt",
    "yjs",
    "mcp",
    "claude-code",
    "codex",
    "cloudflare",
    "skills",
    "docs"
  ],
  "homepage": "https://lltomzhou.github.io/margin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLTOMZHOU/margin.git"
  },
  "bugs": {
    "url": "https://github.com/LLTOMZHOU/margin/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "margin": "bin/margin.js"
  },
  "files": [
    "bin",
    "server",
    "src",
    "cloudflare",
    "mcp",
    "skills",
    "dist",
    "index.html",
    "vite.config.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "mcp": "node mcp/server.js",
    "serve": "node bin/margin.js serve",
    "prepare": "vite build",
    "cf:dev": "vite build && wrangler dev",
    "site:build": "node site/build.js",
    "prepack": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "ws": "^8.22.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  }
}
